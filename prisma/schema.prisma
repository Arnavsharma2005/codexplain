generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ---------- NextAuth ----------

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  githubLogin   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  repoVisits    RepoVisit[]
  analyses      Analysis[]
  analysisViews AnalysisView[]
  usage         UsageDay[]
  intelIndexes  IntelIndex[]
}

// OAuth tokens are intentionally NOT persisted here (see src/lib/auth.ts).
// The GitHub access token only lives inside the encrypted session JWT.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Codexplain ----------

model Repository {
  id            String      @id @default(cuid())
  owner         String
  name          String
  description   String?
  defaultBranch String
  stars         Int         @default(0)
  language      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  visits        RepoVisit[]
  analyses      Analysis[]
  intelIndexes  IntelIndex[]

  @@unique([owner, name])
}

model RepoVisit {
  id           String     @id @default(cuid())
  userId       String
  repositoryId String
  starred      Boolean    @default(false)
  visitCount   Int        @default(1)
  lastVisited  DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([userId, lastVisited])
}

enum AnalysisMode {
  OVERVIEW
  DEEP_DIVE
  REVIEW
}

// One row per (repository, path, file content SHA, mode). The SHA makes this
// both a cache key and a correctness guard: a changed file never reuses an old
// analysis. `createdById` records who first generated it; `AnalysisView`
// records every user who has it in their history.
model Analysis {
  id           String         @id @default(cuid())
  repositoryId String
  createdById  String?
  path         String
  ref          String
  fileSha      String
  language     String?
  mode         AnalysisMode
  content      String         @db.Text
  model        String
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  durationMs   Int            @default(0)
  createdAt    DateTime       @default(now())
  repository   Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  views        AnalysisView[]

  @@unique([repositoryId, path, fileSha, mode])
}

model AnalysisView {
  id         String   @id @default(cuid())
  userId     String
  analysisId String
  shareSlug  String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([userId, analysisId])
  @@index([userId, updatedAt])
}

model UsageDay {
  userId String
  day    DateTime @db.Date
  count  Int      @default(0)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// ---------- Repo intelligence (src/lib/intel) ----------
// A parsed snapshot of one repository at one commit: files, symbols, the
// import graph and search chunks. Chunk embeddings live in IntelEmbedding,
// keyed by content hash, so unchanged code is never embedded twice.

enum IntelStatus {
  INDEXING
  READY
  FAILED
}

model IntelIndex {
  id            String       @id @default(cuid())
  repositoryId  String
  createdById   String?
  ref           String
  commitSha     String
  status        IntelStatus  @default(INDEXING)
  error         String?
  fileCount     Int          @default(0)
  symbolCount   Int          @default(0)
  edgeCount     Int          @default(0)
  chunkCount    Int          @default(0)
  embeddedCount Int          @default(0)
  skippedCount  Int          @default(0)
  bytes         Int          @default(0)
  durationMs    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  repository    Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdBy     User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  files         IntelFile[]
  symbols       IntelSymbol[]
  edges         IntelEdge[]
  chunks        IntelChunk[]

  @@unique([repositoryId, commitSha])
  @@index([createdById, createdAt])
}

model IntelFile {
  id       String        @id @default(cuid())
  indexId  String
  path     String
  language String?
  bytes    Int
  lines    Int
  index    IntelIndex    @relation(fields: [indexId], references: [id], onDelete: Cascade)
  symbols  IntelSymbol[]
  chunks   IntelChunk[]
  outEdges IntelEdge[]   @relation("from")
  inEdges  IntelEdge[]   @relation("to")

  @@unique([indexId, path])
}

model IntelSymbol {
  id        String     @id @default(cuid())
  indexId   String
  fileId    String
  name      String
  kind      String
  startLine Int
  endLine   Int
  exported  Boolean    @default(false)
  index     IntelIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)
  file      IntelFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([indexId, name])
}

model IntelEdge {
  indexId    String
  fromFileId String
  toFileId   String
  index      IntelIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)
  from       IntelFile  @relation("from", fields: [fromFileId], references: [id], onDelete: Cascade)
  to         IntelFile  @relation("to", fields: [toFileId], references: [id], onDelete: Cascade)

  @@id([fromFileId, toFileId])
  @@index([indexId])
}

model IntelChunk {
  id        String                   @id @default(cuid())
  indexId   String
  fileId    String
  startLine Int
  endLine   Int
  symbols   String[]
  text      String                   @db.Text
  hash      String
  // to_tsvector('simple', path + split identifiers + text), written by src/lib/intel/store.ts
  tsv       Unsupported("tsvector")?
  index     IntelIndex               @relation(fields: [indexId], references: [id], onDelete: Cascade)
  file      IntelFile                @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([indexId])
  @@index([fileId, startLine])
  @@index([hash])
  @@index([tsv], type: Gin)
}

model IntelEmbedding {
  hash      String
  model     String
  vector    Unsupported("vector(768)")
  createdAt DateTime                   @default(now())

  @@id([hash, model])
}
