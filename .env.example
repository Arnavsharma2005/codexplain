# Postgres. On Neon, DATABASE_URL is the pooled connection string and
# DIRECT_URL the direct one (used by migrations).
DATABASE_URL="postgresql://postgres@localhost:5432/codexplain"
DIRECT_URL="postgresql://postgres@localhost:5432/codexplain"

# Public URL of the app. Must be set at build time too: security headers
# such as HSTS are only emitted when this is https.
NEXTAUTH_URL="http://localhost:3000"
# At least 32 characters. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# GitHub OAuth app (github.com/settings/developers).
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# Free Gemini API key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=""

# Optional
# GEMINI_MODEL="gemini-3.8-flash"
# Used when the main model is overloaded (503) after one retry.
# GEMINI_FALLBACK_MODEL="gemini-3.6-flash"
# DAILY_ANALYSIS_LIMIT="25"
# MAX_ANALYZABLE_BYTES="150000"
# Raises the GitHub API limit for signed-out visitors (read-only, no scopes).
# GITHUB_SERVER_TOKEN=""

# Repo intelligence (code graph, cited Q&A, blast radius, MCP server). Off by default.
# Needs the pgvector extension (built into Neon).
# INTEL_ENABLED="true"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# INTEL_MAX_FILES="2500"
# INTEL_MAX_TOTAL_BYTES="20000000"
# INTEL_MAX_EMBEDDED_CHUNKS="1200"
# INTEL_DAILY_INDEX_LIMIT="6"
